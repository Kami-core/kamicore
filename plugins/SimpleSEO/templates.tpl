<!-- kami:template manager -->
<section class="admin-section seo-manager" data-seo-manager data-unsaved="{{unsaved}}">
	<section class="admin-panel admin-panel-raised">
		<header class="admin-page-header seo-header"><div><h1>{{heading}}</h1><p>{{domain}}</p></div></header>
	</section>


    <nav class="admin-page-header seo-tabs" aria-label="SEO">{{tabs}}</nav>
    {{message}}
    <div class="admin-pad seo-workspace {{layout_class}}">
        {{navigation}}
        <div class="seo-editor">{{editor}}</div>
    </div>
</section>
